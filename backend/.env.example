ENVIRONMENT=development
# SQLite file for the local server (default: backend/.data/dev.sqlite). Production uses the D1 binding.
# SQLITE_PATH=./.data/dev.sqlite
APP_SECRET=change-me-dev-only
MAILPIT_URL=http://127.0.0.1:8025
MAIL_FROM=SDU Career Match <no-reply@careermatch.local>
TRUST_PROXY_HEADERS=1
# SKIP_MX=1

# AI features (DeepSeek by default; any OpenAI-compatible API works via AI_BASE_URL / AI_MODEL). Without a key the app uses rule-based fallbacks.
# DEEPSEEK_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_DAILY_BUDGET=2000
# AI_USER_DAILY=30

# Telegram bot (optional): create a bot with @BotFather, then set these and call POST /api/admin/telegram/webhook once as admin.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_WEBHOOK_SECRET=<random 32+ chars>
# TELEGRAM_BOT_USERNAME=SduCareerMatchBot
# APP_URL=https://your-domain.example

# Error reporting (optional)
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# Captcha on register / login / recovery (optional): https://dash.cloudflare.com → Turnstile
# TURNSTILE_SECRET=0x...
# TURNSTILE_SITEKEY=0x...

# Semantic matching (optional). On Workers use the AI binding instead (see wrangler.toml). Any OpenAI-compatible embeddings API works:
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
