{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "isolatedModules": true,
    "types": ["vite/client"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"]
}
